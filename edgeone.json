{
  "installCommand": "npm ci && npm ci --prefix web && npm ci --prefix jev",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "nodeVersion": "22.11.0",
  "rewrites": [
    {
      "source": "/jev",
      "destination": "/jev/index.html"
    },
    {
      "source": "/jev/*",
      "destination": "/jev/index.html"
    },
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
